<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080C">

    <ImageView
        android:id="@+id/photoImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:background="#05080C"
        android:contentDescription="@string/dream_image_content_description"
        android:scaleType="fitCenter"
        android:src="@drawable/dream_placeholder" />

    <TextView
        android:id="@+id/modeBadgeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="#99222D3A"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:textColor="#F5F7FA"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#80000000"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp"
        android:text="@string/dream_status_loading"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/captionTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:background="#80000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="#F5F7FA"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/deleteConfirmationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/delete_dialog_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delete_dialog_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="#17212B" />

            <TextView
                android:id="@+id/deleteConfirmationMessageTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="#3B4855" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/deleteCancelButton"
                    android:layout_width="116dp"
                    android:layout_height="48dp"
                    android:background="@drawable/delete_cancel_button_background"
                    android:gravity="center"
                    android:text="@string/action_cancel"
                    android:textColor="#45602A"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/deleteConfirmButton"
                    android:layout_width="116dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/delete_confirm_button_background"
                    android:gravity="center"
                    android:text="@string/action_delete"
                    android:textColor="#17212B"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/exitConfirmationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/delete_dialog_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exit_dialog_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="#17212B" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/exit_dialog_message"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="#3B4855" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/exitCancelButton"
                    android:layout_width="116dp"
                    android:layout_height="48dp"
                    android:background="@drawable/delete_cancel_button_background"
                    android:gravity="center"
                    android:text="@string/action_cancel"
                    android:textColor="#45602A"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/exitConfirmButton"
                    android:layout_width="116dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/delete_confirm_button_background"
                    android:gravity="center"
                    android:text="@string/action_exit"
                    android:textColor="#17212B"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
